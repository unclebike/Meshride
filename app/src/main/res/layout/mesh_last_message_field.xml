<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/mesh_bg_dark"
    android:padding="4dp">

    <!-- Sender initial avatar -->
    <TextView
        android:id="@+id/text_sender_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="?"
        android:textColor="@color/mesh_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/mesh_accent"
        android:layout_marginEnd="6dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_messages"
            android:textColor="@color/mesh_white"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/text_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mesh_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
