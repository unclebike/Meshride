<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@color/mesh_bg_dark"
    android:padding="4dp">

    <ImageView
        android:id="@+id/icon_mesh"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_mesh"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/data_type_node_count" />

    <TextView
        android:id="@+id/text_node_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/mesh_grey"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>
